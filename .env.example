# Copy this file to .env.local and fill in the values. NEVER put real keys in THIS file (it is committed to git).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose to client code, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for auth redirects (password recovery). e.g. https://fintrack.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. IANA time zone used for "today"/current month on the server (default America/Tegucigalpa).
APP_TIMEZONE=America/Tegucigalpa
